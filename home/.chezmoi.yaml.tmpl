{{- /* initialize variable defaults */ -}}
{{- $name                  := "Chris Burnham" -}}
{{- $personal_github_user  := "" -}}
{{- $personal_github_email := "" -}}
{{- $splunk_github_user    := "" -}}
{{- $splunk_github_email   := "" -}}
{{- $splunk_gitlab_user    := "" -}}
{{- $splunk_gitlab_email   := "" -}}
{{- "" -}}

{{/* feature flags */}}
{{- $personal := false -}}{{/* true if this machine should have personal config/secrets */}}
{{- $work     := false -}}{{/* true if this machine should have work config/secrets */}}
{{- "" -}}

{{- if not stdinIsATTY -}}
{{-   writeToStdout "🛑 Error: Container environment detected. Exiting.\n" -}}
{{-   exit 1 -}}

{{- else -}}

{{-   if hasKey . "name" -}}
{{-     $orig_name := .name -}}
{{-     $name = promptString "Name" $orig_name -}}
{{-   else -}}
{{-     $name = promptString "Name" $name -}}
{{-   end -}}

{{-   if hasKey . "personal" -}}
{{-     $orig_personal := .personal -}}
{{-     $personal = promptBool "Enable personal configs/secrets [y|n]" $orig_personal -}}
{{-   else -}}
{{-     $personal = promptBool "Enable personal configs/secrets [y|n]" $personal -}}
{{-   end -}}

{{-   if $personal -}}

{{-     if hasKey . "personal_github_user" -}}
{{-       $orig_personal_github_user := .personal_github_user -}}
{{-       $personal_github_user = promptString "[Personal] GitHub username" $orig_personal_github_user -}}
{{-     else -}}
{{-       $personal_github_user = promptString "[Personal] GitHub username" $personal_github_user -}}
{{-     end -}}

{{-     if hasKey . "personal_github_email" -}}
{{-       $orig_personal_github_email := .personal_github_email -}}
{{-       $personal_github_email = promptString "[Personal] GitHub email" $orig_personal_github_email -}}
{{-     else -}}
{{-       $personal_github_email = promptString "[Personal] GitHub email" $personal_github_email -}}
{{-     end -}}

{{-   end -}}

{{-   if hasKey . "work" -}}
{{-     $orig_work := .work -}}
{{-     $work = promptBool "Enable work configs/secrets [y|n]" $orig_work -}}
{{-   else -}}
{{-     $work = promptBool "Enable work configs/secrets [y|n]" $work -}}
{{-   end -}}

{{-   if $work -}}

{{-     if hasKey . "splunk_github_user" -}}
{{-       $orig_splunk_github_user := .splunk_github_user -}}
{{-       $splunk_github_user = promptString "[Splunk] GitHub username" $orig_splunk_github_user -}}
{{-     else -}}
{{-       $splunk_github_user = promptString "[Splunk] GitHub username" $splunk_github_user -}}
{{-     end -}}

{{-     if hasKey . "splunk_github_email" -}}
{{-       $orig_splunk_github_email := .splunk_github_email -}}
{{-       $splunk_github_email = promptString "[Splunk] GitHub email" $orig_splunk_github_email -}}
{{-     else -}}
{{-       $splunk_github_email = promptString "[Splunk] GitHub email" $splunk_github_email -}}
{{-     end -}}

{{-     if hasKey . "splunk_gitlab_user" -}}
{{-       $orig_splunk_gitlab_user := .splunk_gitlab_user -}}
{{-       $splunk_gitlab_user = promptString "[Splunk] GitLab username" $orig_splunk_gitlab_user -}}
{{-     else -}}
{{-       $splunk_gitlab_user = promptString "[Splunk] GitLab username" $splunk_gitlab_user -}}
{{-     end -}}

{{-     if hasKey . "splunk_gitlab_email" -}}
{{-       $orig_splunk_gitlab_email := .splunk_gitlab_email -}}
{{-       $splunk_gitlab_email = promptString "[Splunk] GitLab email" $orig_splunk_gitlab_email -}}
{{-     else -}}
{{-       $splunk_gitlab_email = promptString "[Splunk] GitLab email" $splunk_gitlab_email -}}
{{-     end -}}

{{-   end -}}

{{-   writeToStdout "💡 Tip: you can re-enter your data with `chezmoi init --data=false`.\n" -}}

{{- end -}}

sourceDir: {{ .chezmoi.sourceDir | quote }}

data:
  name: {{ $name | quote }}
  personal: {{ $personal }}
  {{- if $personal }}
  personal_github_user: {{ $personal_github_user | quote }}
  personal_github_email: {{ $personal_github_email | quote }}
  {{- end }}
  work: {{ $work }}
  {{- if $work }}
  splunk_github_user: {{ $splunk_github_user | quote }}
  splunk_github_email: {{ $splunk_github_email | quote }}
  splunk_gitlab_user: {{ $splunk_gitlab_user | quote }}
  splunk_gitlab_email: {{ $splunk_gitlab_email | quote }}
  {{- end }}
