{{ if eq .chezmoi.os "darwin" -}}
# --------------------------------------------------------------------------------------------------
#   @description    :   Mise
# --------------------------------------------------------------------------------------------------
if (( ${+commands[mise]} )); then
    export MISE_CONFIG_FILE="${XDG_CONFIG_HOME}/mise/config.toml"
    export MISE_DATA_DIR="${XDG_DATA_HOME}/mise"
    export MISE_TRUSTED_CONFIG_PATHS="${MISE_CONFIG_FILE}"
fi
# ==================================================================================================
{{- end }}
