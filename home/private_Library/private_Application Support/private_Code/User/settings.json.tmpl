{
  /*+--- Text Editor ---+*/
  "editor.bracketPairColorization.enabled": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.fontSize": 12,
  "editor.guides.bracketPairs": "active",
  "editor.guides.bracketPairsHorizontal": "active",
  "editor.guides.highlightActiveBracketPair": true,
  "editor.stickyScroll.enabled": true,
  "editor.tabSize": 2,
  "editor.wordWrap": "off",
  "files.associations": {
    "*.json5": "json5",
    "*.toml": "toml",
    "*.yaml": "yaml",
    "*.yml": "yaml"
  },
  "files.autoSave": "onFocusChange",
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,

  /*+--- Workbench ---+*/
  "workbench.editor.preferHistoryBasedLanguageDetection": true,
  "workbench.sideBar.location": "left",
  "workbench.startupEditor": "none",
  "workbench.tree.renderIndentGuides": "none",

  /*+--- Window ---+*/
  "window.commandCenter": false,
  "window.confirmSaveUntitledWorkspace": false,
  "window.newWindowDimensions": "maximized",
  "window.newWindowProfile": "Default",
  "window.restoreWindows": "all",
  "window.titleBarStyle": "custom",

  /*+--- Chat ---+*/
  "chat.disableAIFeatures": true,

  /*+--- Features ---+*/
  "explorer.compactFolders": false,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "terminal.integrated.shellIntegration.enabled": false,

  /*+--- Application ---+*/
  "telemetry.telemetryLevel": "off",
  "update.showReleaseNotes": false,
  "update.mode": "default",

  /*+--- Security ---+*/
  "security.workspace.trust.untrustedFiles": "open",

  /*+--- Extensions ---+*/
  "better-todo-tree.highlights.useColourScheme": true,
  "better-todo-tree.tree.expanded": true,
  "extensions.autoCheckUpdates": true,
  "extensions.autoUpdate": "on",
  "extensions.ignoreRecommendations": true,
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.replaceTagsWhenPull": true,
  "mise.checkForNewMiseVersion": false,
  "path-autocomplete.triggerOutsideStrings": true,
  "redhat.telemetry.enabled": false,
  "vs-kubernetes": {
    "vs-kubernetes.crd-code-completion": "disabled"
  },
  "yaml.schemaStore.enable": true,

  /*+--- Language Scopes ---+*/
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "bluebrown.yamlfmt"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[json5]": {
    "editor.defaultFormatter": "savh.json5-kit"
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[yaml]": {
    "editor.defaultFormatter": "bluebrown.yamlfmt"
  }
}
